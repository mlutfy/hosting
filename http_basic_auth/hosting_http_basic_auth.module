<?php

/**
 * Implements hook_form_alter().
 */
function hosting_http_basic_auth_form_alter(&$form, $form_state, $form_id) {
  if ($form_id == 'site_node_form') {
    $form['http_basic_auth'] = [
      '#type' => 'fieldset',
      '#title' => t('HTTP Basic Authentication'),
      '#description' => t('Specify a password to ensure that only people that know the specifed username and password can access the site.'),
    ];
    $form['http_basic_auth']['http_basic_auth_username'] = [
      '#type' => 'textfield',
      '#title' => t('Username'),
      '#default_value' => isset($form['#node']->http_basic_auth_username) ? $form['#node']->http_basic_auth_username : '',
      '#weight' => 0,
    ];
    $form['http_basic_auth']['http_basic_auth_password'] = [
      '#type' => 'textfield',
      '#title' => t('Password'),
      '#default_value' => isset($form['#node']->http_basic_auth_password) ? $form['#node']->http_basic_auth_password : '',
      '#weight' => 1,
    ];
    $form['http_basic_auth']['http_basic_auth_whitelist'] = [
      '#type' => 'textfield',
      '#title' => t('IP address exceptions'),
      '#default_value' => isset($form['#node']->http_basic_auth_whitelist) ? $form['#node']->http_basic_auth_whitelist : '',
      '#description' => t('Always allow from these IP addresses.') . ' ' . t('Space separated list of IP addresses. CIDR notations are accepted (ex: 1.2.3.0/24).'),
      '#weight' => 2,
    ];
    $form['http_basic_auth']['http_basic_auth_message'] = [
      '#type' => 'textfield',
      '#title' => t('Message'),
      '#default_value' => isset($form['#node']->http_basic_auth_message) ? $form['#node']->http_basic_auth_message : t('Restricted access'),
      '#weight' => 3,
    ];
    return $form;
  }
}

/**
 * Either inserts or updates the auth record for a node.
 */
function _hosting_http_basic_auth_save($node) {
  db_merge('hosting_http_basic_auth')
    ->key(array('nid' => $node->nid))
    ->fields(array(
      'username' => $node->http_basic_auth_username,
      'password' => isset($node->http_basic_auth_password) ? $node->http_basic_auth_password : '',
      'message' => isset($node->http_basic_auth_message) ? $node->http_basic_auth_message : '',
      'whitelist' => isset($node->http_basic_auth_whitelist) ? $node->http_basic_auth_whitelist : '',
    ))
    ->execute();

  // Our values are attached to the node in hook_node_load(), so a node object
  // cached before this save would still carry the old credentials.
  entity_get_controller('node')->resetCache(array($node->nid));
}

/**
 * Deletes the auth record for a node.
 */
function _hosting_http_basic_auth_delete($node) {
  db_delete('hosting_http_basic_auth')
    ->condition('nid', $node->nid)
    ->execute();

  entity_get_controller('node')->resetCache(array($node->nid));
}

/**
 * Implements hook_node_insert().
 */
function hosting_http_basic_auth_node_insert($node) {
  if ($node->type == 'site' && !empty($node->http_basic_auth_username)) {
    _hosting_http_basic_auth_save($node);
  }
}

/**
 * Implements hook_node_update().
 */
function hosting_http_basic_auth_node_update($node) {
  if ($node->type != 'site') {
    return;
  }

  // Only act when the save actually carried our fields. Site nodes are saved
  // all the time by task callbacks, migrations and feeds, on node objects that
  // never went through hook_node_load() - treating those as "the user cleared
  // the credentials" would delete them. A node loaded normally always has the
  // properties set (see hook_node_load()), and the site form always submits
  // them, so an empty string here really is an explicit clear.
  if (!isset($node->http_basic_auth_username)) {
    return;
  }

  if ($node->http_basic_auth_username === '') {
    // Nothing to remove on the many site saves that never had credentials.
    if (!empty($node->original->http_basic_auth_username)) {
      _hosting_http_basic_auth_delete($node);
    }
  }
  else {
    _hosting_http_basic_auth_save($node);
  }
}

/**
 * Implements hook_node_delete().
 */
function hosting_http_basic_auth_node_delete($node) {
  if ($node->type == 'site') {
    _hosting_http_basic_auth_delete($node);
  }
}

/**
 * Implements hook_node_validate().
 */
function hosting_http_basic_auth_node_validate($node) {
  if ($node->type == 'site') {
    if (!empty($node->http_basic_auth_username) && empty($node->http_basic_auth_password)) {
      form_set_error('http_basic_auth_password', t('You must specify a password for the HTTP basic authentication.'));
    }
    if (!empty($node->http_basic_auth_whitelist) && !preg_match('/^[0-9a-z \/\.:]+$/i', $node->http_basic_auth_whitelist)) {
      form_set_error('http_basic_auth_whitelist', t('The IP whitelist field contains illegal characters.'));
    }
  }
}

/**
 * Implements hook_node_load().
 */
function hosting_http_basic_auth_node_load($nodes, $types) {
  foreach ($nodes as $nid => $node) {
    if ($node->type == 'site') {
      $additions = db_query("SELECT username AS http_basic_auth_username, password AS http_basic_auth_password, message AS http_basic_auth_message, whitelist AS http_basic_auth_whitelist FROM {hosting_http_basic_auth} WHERE nid = :nid", array(':nid' => $node->nid))->fetchAssoc();
      if (empty($additions)) {
        $additions = array(
          'http_basic_auth_username' => '',
          'http_basic_auth_password' => '',
          'http_basic_auth_message' => '',
          'http_basic_auth_whitelist' => '',
        );
      }
      foreach ($additions as $key => $value) {
        $nodes[$nid]->$key = $value;
      }
    }
  }
}

/**
 * Implements hook_feeds_node_processor_targets_alter().
 */
function hosting_http_basic_auth_feeds_node_processor_targets_alter(&$targets, $content_type) {
  if ($content_type == 'site') {
    $targets['http_basic_auth_username'] = array(
      'name' => t('HTTP Basic Auth - username'),
      'description' => t('Set this to enable HTTP basic auth on the site.'),
      'callback' => 'hosting_http_basic_auth_set_target_http_basic_auth_simple',
    );
    $targets['http_basic_auth_password'] = array(
      'name' => t('HTTP Basic Auth - password'),
      'description' => t('The password, this is not transferred securely and should be considered in the public domain.'),
      'callback' => 'hosting_http_basic_auth_set_target_http_basic_auth_simple',
    );
    $targets['http_basic_auth_message'] = array(
      'name' => t('HTTP Basic Auth - username'),
      'description' => t('A message to show when prompting the user for username and password.'),
      'callback' => 'hosting_http_basic_auth_set_target_http_basic_auth_message',
    );
    $targets['http_basic_auth_whitelist'] = array(
      'name' => t('HTTP Basic Auth - IP whitelist'),
      'description' => t('IPs that are whitelisted from the basic authentication.'),
      'callback' => 'hosting_http_basic_auth_set_target_http_basic_auth_simple',
    );

  }
}

/**
 * Mapping callback for feeds.
 */
function hosting_http_basic_auth_set_target_http_basic_auth_simple($node, $target, $value) {
  if (!empty($value)) {
    $node->$target = $value;
  }
}

/**
 * Mapping callback for feeds.
 */
function hosting_http_basic_auth_set_target_http_basic_auth_message($node, $target, $value) {
  $node->$target = !empty($value) ? $value : t('Restricted access');
}

/**
 * Implements hook_node_view().
 */
function hosting_http_basic_auth_node_view($node, $view_mode, $langcode = NULL) {
  if ($node->type != "site") {
    return;
  }
  if (!empty($node->http_basic_auth_username)) {
    $node->content['info']['http_basic_auth'] = [
      '#type' => 'item',
      '#title' => t('Restricted access credentials'),
      '#markup' => $node->http_basic_auth_username . ' / ' . $node->http_basic_auth_password,
      '#weight' => 0,
    ];
  }
}
