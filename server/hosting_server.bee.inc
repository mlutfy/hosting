<?php

/**
 * Implements hook_bee_command().
 */
function hosting_server_bee_command() {
  $items = [];
  $items['hosting-server-upgrade-platforms'] = [
    'description' => 'Queue an upgrade task for all platforms',
    'bootstrap' => BACKDROP_BOOTSTRAP_FULL,
    'callback' => 'bee_hosting_server_upgrade_platforms',
  ];
  $items['hosting-server-upgrade-aegir'] = [
    'description' => 'Queue a server upgrade-aegir task, wait for all the tasks it generates and write a JSON report',
    'bootstrap' => BACKDROP_BOOTSTRAP_FULL,
    'callback' => 'bee_hosting_server_upgrade_aegir',
    'options' => [
      'timeout' => [
        'description' => bt('Maximum number of seconds to wait for the tasks to complete (default: 3600).'),
        'value' => bt('seconds'),
      ],
      'interval' => [
        'description' => bt('Number of seconds between two polls of the task queue (default: 5).'),
        'value' => bt('seconds'),
      ],
      'json' => [
        'description' => bt('Path of the JSON report, "-" or no value for stdout, "none" to skip it (default: /var/aegir/upgrade-aegir.json).'),
        'value' => bt('path'),
      ],
      'no-wait' => [
        'description' => bt('Queue the tasks and exit immediately, without polling or writing reports.'),
      ],
    ],
  ];
  $items['hosting-server-verify'] = [
    'description' => 'Queue a server verify task',
    'bootstrap' => BACKDROP_BOOTSTRAP_FULL,
    'callback' => 'bee_hosting_server_verify',
  ];
  return $items;
}

/**
 * Queue an 'upgrade' task for all enabled platforms.
 * Called from Ansible
 */
function bee_hosting_server_upgrade_platforms($arguments, $options) {
  $platforms = db_query("SELECT n.nid, n.title FROM {hosting_platform} h
    LEFT JOIN {node} n ON (n.nid = h.nid)
    WHERE n.type = :type AND n.status = 1 AND h.status = :status
    ORDER BY n.nid ASC", [
    ':type' => 'platform',
    ':status' => HOSTING_PLATFORM_ENABLED,
  ]);

  foreach ($platforms as $platform) {
    $task = hosting_add_task($platform->nid, 'upgrade');
    if (empty($task)) {
      // hosting_add_task() returns FALSE if the task is not allowed on that node.
      echo t('Could not queue an upgrade task for platform @title (@nid).', ['@title' => $platform->title, '@nid' => $platform->nid], WATCHDOG_WARNING) . "\n";
      continue;
    }
    echo t('Queued an upgrade task for: @title (@nid)', ['@title' => $platform->title, '@nid' => $platform->nid]) . "\n";
  }
}

/**
 * Queue an 'upgrade-aegir' task for all servers, then wait for that task and
 * for all the tasks it generates (platform upgrades, site upgrades, ...).
 *
 * Writes a JSON report of the tasks, grouped by server, and exits with a
 * non-zero status if any of them failed or did not complete before the
 * timeout.
 *
 * The report can be written to stdout instead of to a file, using "-" as the
 * filename, so that Ansible can collect it from the command output rather than
 * having to fetch a file from the server. In that case the progress messages
 * are written to stderr, to keep stdout parsable.
 *
 * Use server/upgrade-aegir-junit.php to turn the JSON into a JUnit XML report
 * for a CI, on whichever host needs it.
 *
 * Called from Ansible (telemetrie)
 */
function bee_hosting_server_upgrade_aegir($arguments, $options) {
  $timeout = $options['timeout'] ?? 3600;
  $interval = $options['interval'] ?? 5;
  $interval = max(1, $interval);
  // Output to stdout by default
  $json_file = $options['json'] ?? '-';
  $json_file = ($json_file === 'none') ? '' : $json_file;

  // When the report goes to stdout, our own messages move out of the way, to
  // stderr: mixing the two would make the report unparsable.
  $to_stdout = ($json_file === '-');
  _hosting_server_upgrade_aegir_use_stderr($to_stdout);

  $started = time();

  // Record the highest task nid before queueing anything, so that we know
  // which tasks were generated by this run. Task nids are node nids, so any
  // task created from now on will have a higher nid.
  $max_nid = (int) db_query('SELECT MAX(nid) FROM {hosting_task}')->fetchField();

  $servers = db_query('SELECT n.nid, n.title FROM {hosting_server} h
    INNER JOIN {node} n ON (n.vid = h.vid)
    WHERE h.status = :status
    ORDER BY n.nid ASC', [
    ':status' => HOSTING_SERVER_ENABLED,
  ]);

  $queued = 0;
  foreach ($servers as $server) {
    $task = hosting_add_task($server->nid, 'upgrade-aegir');
    if (empty($task)) {
      // hosting_add_task() returns FALSE if the task is not allowed on that node.
      _hosting_server_upgrade_aegir_log(t('Could not queue an upgrade-aegir task for server @title (@nid).', ['@title' => $server->title, '@nid' => $server->nid]));
      continue;
    }
    $queued++;
    _hosting_server_upgrade_aegir_log(t('Queued an upgrade-aegir task for: @title (@nid), task @task', [
      '@title' => $server->title,
      '@nid' => $server->nid,
      '@task' => $task->nid,
    ]));
  }

  if (empty($queued)) {
    _hosting_server_upgrade_aegir_log(t('No upgrade-aegir task could be queued, there is nothing to wait for.'));
    exit(1);
  }

  if (!empty($options['no-wait'])) {
    return;
  }

  // The timeout covers the wait, not the time it took to queue the tasks.
  $deadline = time() + $timeout;
  $timed_out = FALSE;
  $tasks = [];
  $empty_polls = 0;
  $last_pending = -1;
  $polls = 0;

  _hosting_server_upgrade_aegir_log(t('Waiting up to @timeout seconds for the tasks to complete, polling every @interval seconds.', [
    '@timeout' => $timeout,
    '@interval' => $interval,
  ]));

  while (TRUE) {
    $tasks = _hosting_server_upgrade_aegir_tasks($max_nid);

    $pending = 0;
    foreach ($tasks as $task) {
      if (_hosting_server_upgrade_aegir_is_pending($task->task_status)) {
        $pending++;
      }
    }

    if (empty($pending)) {
      // A running task usually queues its follow-up tasks (platform upgrades
      // queue site upgrades, ...), so the queue can be empty for a moment in
      // the middle of the run. Only stop once it has been empty twice in a row.
      $empty_polls++;
      if ($empty_polls >= 2) {
        break;
      }
    }
    else {
      $empty_polls = 0;
    }

    if (time() >= $deadline) {
      $timed_out = ($pending > 0);
      break;
    }

    // Avoid flooding the logs: only report when something changed, or once in
    // a while so that we can tell that we are still alive.
    if ($pending != $last_pending || ($polls % 20) == 0) {
      _hosting_server_upgrade_aegir_log(t('@pending of @total task(s) still queued or processing (@elapsed seconds elapsed).', [
        '@pending' => $pending,
        '@total' => count($tasks),
        '@elapsed' => time() - $started,
      ]));
    }
    $last_pending = $pending;
    $polls++;

    sleep(min($interval, max(1, $deadline - time())));
  }

  $report = _hosting_server_upgrade_aegir_report($tasks, $started, $timed_out, $max_nid);

  // Print a summary, mostly for the Ansible logs.
  foreach ($report['servers'] as $server) {
    _hosting_server_upgrade_aegir_log(t('Server @server: @tests task(s), @failures failed, @errors incomplete.', [
      '@server' => $server['server'],
      '@tests' => count($server['tasks']),
      '@failures' => $server['failures'],
      '@errors' => $server['errors'],
    ]));
    foreach ($server['tasks'] as $task) {
      if ($task['status'] == HOSTING_TASK_SUCCESS) {
        continue;
      }
      _hosting_server_upgrade_aegir_log('  ' . t('[@status] @type @target (task @nid, @duration seconds)', [
        '@status' => $task['status_label'],
        '@type' => $task['task_type'],
        '@target' => $task['target'],
        '@nid' => $task['nid'],
        '@duration' => $task['duration'],
      ]));
    }
  }

  $written = _hosting_server_upgrade_aegir_write($json_file, _hosting_server_upgrade_aegir_json($report));

  if ($report['timed_out']) {
    _hosting_server_upgrade_aegir_log(t('Timed out after @timeout seconds, @errors task(s) did not complete.', [
      '@timeout' => $timeout,
      '@errors' => $report['errors'],
    ]));
  }

  _hosting_server_upgrade_aegir_log(t('@tests task(s), @failures failed, @errors incomplete, @warnings with warnings, in @duration seconds.', [
    '@tests' => $report['tests'],
    '@failures' => $report['failures'],
    '@errors' => $report['errors'],
    '@warnings' => $report['warnings'],
    '@duration' => $report['duration'],
  ]));

  $code = ($report['failures'] || $report['errors'] || !$written) ? 1 : 0;
  if ($code || $to_stdout) {
    exit($code);
  }
}

/**
 * Queue a 'verify' task for the server.
 * Called from Ansible
 */
function bee_hosting_server_verify($arguments, $options) {
  $servers = db_query('SELECT nid FROM hosting_server WHERE status = :status', [
    ':status' => HOSTING_SERVER_ENABLED,
  ]);
  foreach ($servers as $server) {
    $task = hosting_add_task($server->nid, 'verify');
  }
}

/**
 * Whether a task status means that the task has not completed yet.
 */
function _hosting_server_upgrade_aegir_is_pending($status) {
  return (int) $status === HOSTING_TASK_QUEUED || (int) $status === HOSTING_TASK_PROCESSING;
}

/**
 * Load all the tasks created after the given task nid.
 *
 * Joins on the node table so that we always get the status of the current
 * revision of the task.
 *
 * @param int $max_nid
 *   The highest task nid that existed before the run started.
 *
 * @return array
 *   Task rows, keyed by task nid.
 */
function _hosting_server_upgrade_aegir_tasks($max_nid) {
  $result = db_query('SELECT t.nid, t.vid, t.rid, t.task_type, t.task_status, t.executed, t.delta, n.title, n.created
    FROM {hosting_task} t
    INNER JOIN {node} n ON (n.vid = t.vid)
    WHERE t.nid > :nid
    ORDER BY t.nid ASC', [
    ':nid' => $max_nid,
  ]);

  $tasks = [];
  foreach ($result as $task) {
    $tasks[$task->nid] = $task;
  }
  return $tasks;
}

/**
 * Resolve the site, platform and server a task was run on.
 *
 * @param int $rid
 *   The nid of the node the task was run on (hosting_task.rid).
 *
 * @return array
 *   An associative array with the target type/title, and the site, platform
 *   and server it belongs to, when they can be resolved.
 */
function _hosting_server_upgrade_aegir_context($rid) {
  static $cache = [];

  if (isset($cache[$rid])) {
    return $cache[$rid];
  }

  $context = [
    'target_nid' => (int) $rid,
    'target_type' => '',
    'target' => '',
    'site' => NULL,
    'platform' => NULL,
    'platform_nid' => 0,
    'server' => NULL,
    'server_nid' => 0,
  ];

  $node = db_query('SELECT nid, type, title FROM {node} WHERE nid = :nid', [':nid' => $rid])->fetchObject();
  if (empty($node)) {
    return $cache[$rid] = $context;
  }

  $context['target_type'] = $node->type;
  $context['target'] = $node->title;

  switch ($node->type) {
    case 'server':
      $context['server_nid'] = (int) $node->nid;
      $context['server'] = $node->title;
      break;

    case 'platform':
      $context['platform_nid'] = (int) $node->nid;
      $context['platform'] = $node->title;
      $web_server = (int) db_query('SELECT p.web_server FROM {hosting_platform} p
        INNER JOIN {node} n ON (n.vid = p.vid)
        WHERE n.nid = :nid', [':nid' => $node->nid])->fetchField();
      if (!empty($web_server)) {
        $server = _hosting_server_upgrade_aegir_context($web_server);
        $context['server_nid'] = $server['server_nid'];
        $context['server'] = $server['server'];
      }
      break;

    case 'site':
      $context['site'] = $node->title;
      $platform_nid = (int) db_query('SELECT s.platform FROM {hosting_site} s
        INNER JOIN {node} n ON (n.vid = s.vid)
        WHERE n.nid = :nid', [':nid' => $node->nid])->fetchField();
      if (!empty($platform_nid)) {
        $platform = _hosting_server_upgrade_aegir_context($platform_nid);
        $context['platform_nid'] = $platform['platform_nid'];
        $context['platform'] = $platform['platform'];
        $context['server_nid'] = $platform['server_nid'];
        $context['server'] = $platform['server'];
      }
      break;
  }

  return $cache[$rid] = $context;
}

/**
 * Load the error and warning log lines of a task revision.
 *
 * Ansible failures are logged as warnings by HostingAnsibleProcessor, so we
 * report both types.
 */
function _hosting_server_upgrade_aegir_messages($vid) {
  $result = db_query('SELECT type, message, error, timestamp FROM {hosting_task_log}
    WHERE vid = :vid
    ORDER BY lid ASC', [
    ':vid' => $vid,
  ]);

  $messages = [];
  foreach ($result as $log) {
    $messages[] = [
      'type' => $log->type,
      'message' => _hosting_server_upgrade_aegir_clean($log->message),
      'error' => _hosting_server_upgrade_aegir_clean($log->error),
      'timestamp' => (int) $log->timestamp,
    ];
  }
  return $messages;
}

/**
 * Clean up a log line so that it can safely go into the reports.
 *
 * Ansible output can contain terminal escape sequences, control characters
 * that are not valid in XML 1.0, and invalid UTF-8. The latter would make
 * json_encode() fail on the whole report, not just on that line.
 */
function _hosting_server_upgrade_aegir_clean($text) {
  $text = (string) $text;

  // Terminal color codes are just noise in a report.
  $text = preg_replace('/\x1b\[[0-9;]*[a-zA-Z]/', '', $text);

  // Drop anything that is not valid UTF-8.
  if (function_exists('mb_convert_encoding')) {
    $text = mb_convert_encoding($text, 'UTF-8', 'UTF-8');
  }
  elseif (function_exists('iconv')) {
    $converted = @iconv('UTF-8', 'UTF-8//IGNORE', $text);
    $text = ($converted === FALSE) ? $text : $converted;
  }

  // Drop the characters that are not valid in XML 1.0.
  $clean = preg_replace('/[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}]/u', '', $text);
  if ($clean === NULL) {
    // Still not valid UTF-8, fall back to stripping everything but ASCII.
    $clean = preg_replace('/[^\x09\x0A\x0D\x20-\x7E]/', '', $text);
  }
  return $clean;
}

/**
 * Build the report structure, grouped by server.
 *
 * @param array $tasks
 *   Task rows, as returned by _hosting_server_upgrade_aegir_tasks().
 * @param int $started
 *   Timestamp of the beginning of the run.
 * @param bool $timed_out
 *   Whether we stopped polling before all the tasks completed.
 * @param int $max_nid
 *   The highest task nid that existed before the run started.
 */
function _hosting_server_upgrade_aegir_report($tasks, $started, $timed_out, $max_nid) {
  $now = time();
  $report = [
    'command' => 'hosting-server-upgrade-aegir',
    'max_task_nid' => (int) $max_nid,
    'started' => $started,
    'finished' => $now,
    'duration' => $now - $started,
    'timed_out' => (bool) $timed_out,
    'tests' => 0,
    'failures' => 0,
    'errors' => 0,
    'warnings' => 0,
    'servers' => [],
  ];

  $labels = _hosting_task_error_codes();

  foreach ($tasks as $task) {
    $context = _hosting_server_upgrade_aegir_context($task->rid);
    $status = (int) $task->task_status;
    $pending = _hosting_server_upgrade_aegir_is_pending($status);

    // hosting_task.delta is only set once the task completed, so compute the
    // elapsed time ourselves for the tasks that are still running.
    if (!empty($task->delta)) {
      $duration = (int) $task->delta;
    }
    elseif ($pending && !empty($task->executed)) {
      $duration = $now - (int) $task->executed;
    }
    else {
      $duration = 0;
    }

    $entry = [
      'nid' => (int) $task->nid,
      'vid' => (int) $task->vid,
      'task_type' => $task->task_type,
      'target_nid' => $context['target_nid'],
      'target_type' => $context['target_type'],
      'target' => $context['target'],
      'site' => $context['site'],
      'platform' => $context['platform'],
      'server' => $context['server'],
      'status' => $status,
      'status_label' => isset($labels[$status]) ? (string) $labels[$status] : (string) $status,
      'pending' => $pending,
      'created' => (int) $task->created,
      'executed' => (int) $task->executed,
      'duration' => $duration,
      'messages' => _hosting_server_upgrade_aegir_messages($task->vid),
    ];

    $key = $context['server_nid'];
    if (!isset($report['servers'][$key])) {
      $report['servers'][$key] = [
        'server_nid' => $context['server_nid'],
        'server' => $context['server'] ? $context['server'] : t('unknown server'),
        'started' => $entry['created'],
        'duration' => 0,
        'failures' => 0,
        'errors' => 0,
        'warnings' => 0,
        'tasks' => [],
      ];
    }

    if ($entry['created'] && $entry['created'] < $report['servers'][$key]['started']) {
      $report['servers'][$key]['started'] = $entry['created'];
    }
    $report['servers'][$key]['duration'] += $duration;
    $report['servers'][$key]['tasks'][] = $entry;
    $report['tests']++;

    if ($pending) {
      $report['servers'][$key]['errors']++;
      $report['errors']++;
    }
    elseif ($status === HOSTING_TASK_ERROR) {
      $report['servers'][$key]['failures']++;
      $report['failures']++;
    }
    elseif ($status === HOSTING_TASK_WARNING) {
      $report['servers'][$key]['warnings']++;
      $report['warnings']++;
    }
  }

  return $report;
}

/**
 * Render the JSON report.
 */
function _hosting_server_upgrade_aegir_json($report) {
  $json = $report;
  // Keep the servers as a list, JSON objects keyed by nid are less convenient
  // to iterate on from Ansible.
  $json['servers'] = array_values($report['servers']);

  $flags = JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
  $encoded = json_encode($json, $flags);
  if ($encoded === FALSE && defined('JSON_PARTIAL_OUTPUT_ON_ERROR')) {
    // Better a report with a few empty strings than no report at all.
    $encoded = json_encode($json, $flags | JSON_PARTIAL_OUTPUT_ON_ERROR);
  }
  if ($encoded === FALSE) {
    $encoded = json_encode(['error' => 'json_encode: ' . json_last_error_msg()]);
  }
  return $encoded . "\n";
}

/**
 * Write a report to a file, or to stdout if the filename is '-'.
 *
 * An empty filename means that this report was not requested.
 *
 * @return bool
 *   TRUE if the report was written.
 */
function _hosting_server_upgrade_aegir_write($filename, $contents) {
  if (empty($filename)) {
    return TRUE;
  }
  if ($filename === '-') {
    if (defined('STDOUT')) {
      fwrite(STDOUT, $contents);
    }
    else {
      echo $contents;
    }
    return TRUE;
  }
  if (@file_put_contents($filename, $contents) === FALSE) {
    _hosting_server_upgrade_aegir_log(t('Could not write the report to @filename.', ['@filename' => $filename]));
    return FALSE;
  }
  _hosting_server_upgrade_aegir_log(t('Wrote the report to @filename.', ['@filename' => $filename]));
  return TRUE;
}

/**
 * Set or get whether our messages should be written to stderr.
 *
 * They are, when a report is written to stdout: mixing the two would make the
 * report unparsable.
 */
function _hosting_server_upgrade_aegir_use_stderr($stderr = NULL) {
  static $use_stderr = FALSE;
  if (isset($stderr)) {
    $use_stderr = (bool) $stderr;
  }
  return $use_stderr;
}

/**
 * Print a progress message, on stderr when stdout holds a report.
 */
function _hosting_server_upgrade_aegir_log($message) {
  if (_hosting_server_upgrade_aegir_use_stderr() && defined('STDERR')) {
    fwrite(STDERR, $message . "\n");
  }
  else {
    echo $message . "\n";
  }
}
