<?php
/**
 * @file
 * Define database schema and update functions for the hosting_site module.
 *
 */

/**
 * Implements hook_install() for Backdrop
 */
function hosting_site_install() {
  if (!defined('BACKDROP_ROOT')) {
    return;
  }
  // See https://docs.backdropcms.org/change-records/hook_node_info-removed
  $type = [
    "type" => 'site',
    "name" => 'Site',
    'base' => 'hosting_site',
    "has_title" => TRUE,
    "title_label" => 'Domain name',
    "description" => t("<strong>An instance of a hosted site.</strong>\nIt contains information relating to the site, most notably the domain name, database server and platform it is being published on. A site may also have several aliases for additional domains the site needs to be accessible on."),
    "has_body" => 0,
    "body_label" => '',
    "min_word_count" => 0,
    // Lock the machine name
    'locked' => TRUE,
  ];
  $type = node_type_set_defaults($type);
  node_type_save($type);
}

/**
 * Implements hook_enable().
 *
 * Adds a layout for platform nodes showing the list of sites on the platform.
 */
function hosting_site_enable() {
  if (!defined('BACKDROP_ROOT')) {
    return;
  }
  _hosting_site_layout_add_site_list_block();
}

/**
 * Adds the hosting_site_list block to a layout limited to platform nodes.
 *
 * The block_sites display of the hosting_site_list view has a contextual filter
 * on the platform, so the block lists the sites installed on the platform being
 * viewed.
 *
 * The block cannot simply be added to the default layout with a "Content: Type"
 * visibility condition: that condition requires a node context, and the default
 * layout never has one, because it is loaded without its menu item (see
 * layout_load_multiple_by_path()). Backdrop hides the condition in the UI for
 * that reason. So we clone the default layout, restrict the clone to platform
 * nodes and add the block to it. Backdrop falls back to the default layout for
 * every other node.
 *
 * Called on install (hook_enable) and by the update hooks, so it must be
 * idempotent: it does nothing if the layout already exists.
 *
 * @param string $region
 *   The name of the region within the layout, ex: 'bottom'.
 *
 * @return bool
 *   TRUE if the layout was created, FALSE if it was skipped.
 */
function _hosting_site_layout_add_site_list_block($region = 'bottom') {
  if (!function_exists('layout_load') || !module_exists('views')) {
    return FALSE;
  }

  $layout_name = 'hosting_platform';

  // The block delta for a Views block is "viewname-displayid".
  $delta = 'hosting_site_list-block_sites';

  // Do not re-create the layout, ex: if the module is disabled and re-enabled,
  // or if the site admin deliberately removed the block from it.
  $configs = layout_get_all_configs('layout');

  if (isset($configs[$layout_name])) {
    return FALSE;
  }

  // The view is provided as default config by this module, so the cached list
  // of blocks does not know about it yet when we are being installed.
  views_invalidate_cache();
  backdrop_static_reset('layout_get_block_info');

  // Start from the default layout, so that platform nodes keep the header, the
  // menus and the page content of every other page.
  $default = layout_load('default');

  if (empty($default)) {
    return FALSE;
  }

  // The layout template must actually provide the region we are aiming for,
  // ex: if the site admin switched to a layout without a "bottom" region.
  $template = layout_get_layout_template_info($default->layout_template);

  if (empty($template['regions'][$region])) {
    return FALSE;
  }

  // Workaround for Backdrop core bug:
  // Layout::getClone() assumes that every block UUID listed in the layout's
  // $positions also exists in its $content, and blindly dereferences
  // $content[$uuid]. On sites whose default layout drifted out of sync, ex: a
  // block that was removed from $content but left behind in $positions, that
  // fails with an "Undefined array key <uuid>" error followed by a fatal error
  // on a NULL block. Work on a copy with the stale positions dropped, so that
  // an inconsistency in the default layout does not abort the update.
  //
  // The copy is shallow on purpose: only $positions is rewritten below, and
  // getClone() replaces every block with a clone of its own, so the layout
  // cached by layout_load() is left untouched.
  $default = clone $default;
  $positions = [];

  foreach ($default->positions as $region_name => $uuids) {
    $positions[$region_name] = array();

    foreach ($uuids as $uuid) {
      if (isset($default->content[$uuid]) && is_object($default->content[$uuid])) {
        $positions[$region_name][] = $uuid;
      }
      else {
        watchdog('hosting_site', 'Skipping block @uuid while copying the default layout: it is listed in the @region region, but the layout has no such block. The default layout should be repaired.', array(
          '@uuid' => $uuid,
          '@region' => $region_name,
        ), WATCHDOG_WARNING);
      }
    }
  }

  $default->positions = $positions;

  $layout = $default->getClone();

  // The name must be set before the path: setPath() names the menu item after
  // the layout.
  $layout->name = $layout_name;
  $layout->title = t('Platform');
  $layout->setPath('node/%');

  // Only use this layout for nodes of type 'platform'. The plugin name is built
  // by layout_layout_access_info() as "<entity type>_<bundle key>".
  $condition = layout_create_access('node_type');
  $condition->settings['bundles'] = array('platform');
  $layout->conditions[] = $condition;

  // An earlier version of this function added the block to the default layout
  // itself, so the copy we just made may already contain it.
  foreach ($layout->content as $block) {
    if ($block->module == 'views' && $block->delta == $delta) {
      $layout->save();

      return TRUE;
    }
  }

  $layout->addBlock('views', $delta, $region);
  $layout->save();

  return TRUE;
}

/**
 * Implements hook_schema().
 */
function hosting_site_schema() {
  $schema['hosting_site'] = array(
    'fields' => array(
      'vid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'client' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'db_server' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'db_name' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'default' => '',
      ),
      'db_passwd' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'default' => '',
      ],
      'platform' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'profile' => array(
        'type' => 'int',
        'not null' => FALSE,
        'default' => NULL,
      ),
      'language' => array(
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'default' => 'en',
      ),
      'last_cron' => array(
        'type' => 'int',
        'not null' => FALSE,
      ),
      'cron_key' => array(
        'type' => 'varchar',
        'not null' => FALSE,
        'length' => 80,
        'default' => '',
      ),
      'verified' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'status' => array(
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ),
      'environment' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => '0 = development, 1 = production',
      ],
      'cron_interval' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ),
    'primary key' => array('vid'),
  );

  $schema['hosting_site_backups'] = array(
    'fields' => array(
      'bid' => array(
        'type' => 'serial',
        'not null' => TRUE,
      ),
      'site' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'web_server' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'description' => array(
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ),
      'filename' => array(
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ),
      'size' => array(
        'type' => 'int',
        'size' => 'big',
        'not null' => FALSE,
      ),
      'timestamp' => array(
        'type' => 'int',
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('bid'),
  );

  return $schema;
}

/**
 * Add the db_passwd column.
 */
function hosting_site_update_7500() {
  if (!db_field_exists('hosting_site', 'db_passwd')) {
    db_add_field('hosting_site', 'db_passwd', [
      'type' => 'varchar',
      'length' => 65,
      'not null' => TRUE,
      'default' => '',
    ]);
  }
}

/**
 * Add the environment column.
 */
function hosting_site_update_7501() {
  if (!db_field_exists('hosting_site', 'environment')) {
    db_add_field('hosting_site', 'environment', [
      'type' => 'int',
      'size' => 'tiny',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
      'description' => '0 = development, 1 = production',
    ]);
  }
}

/**
 * Add the cron_interval column.
 */
function hosting_site_update_7502() {
  if (!db_field_exists('hosting_site', 'cron_interval')) {
    db_add_field('hosting_site', 'cron_interval', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ]);
  }
}

/**
 * Fill in empty db_passwd using drushrc.php.
 */
function hosting_site_update_7503() {
  // Drupal sites
  if (function_exists('hosting_civicrm_ansible_get_all_sites')) {
    $nids = hosting_civicrm_ansible_get_all_sites(TRUE);
    $sites = node_load_multiple($nids);
    foreach ($sites as $site) {
      if (!empty($site->db_passwd) && !empty($site->db_name)) {
        continue;
      }
      $drushrc = $site->publish_path . '/sites/' . $site->title . '/drushrc.php';
      if (file_exists($drushrc)) {
        global $options;
        $options['db_name'] = NULL;
        $options['db_passwd'] = NULL;
        require $drushrc;
        if (empty($site->db_name) && !empty($options['db_name'])) {
	  db_query('UPDATE hosting_site SET db_name = :name WHERE nid = :nid', [':name' => $options['db_name'], ':nid' => $site->nid]);
        }
        if (empty($site->db_passwd) && !empty($options['db_passwd'])) {
	  db_query('UPDATE hosting_site SET db_passwd = :db_passwd WHERE nid = :nid', [':db_passwd' => $options['db_passwd'], ':nid' => $site->nid]);
        }
      }
    }
  }
  // WordPress sites
  if (function_exists('hosting_get_wpsites_by_status')) {
    $sites = hosting_get_wpsites_by_status(null, HOSTING_WPSITE_ENABLED);
    foreach ($sites as $site) {
      if (!empty($site->db_passwd) && !empty($site->db_name)) {
        continue;
      }
      $platform = node_load($site->wpplatform);
      $drushrc = $platform->publish_path . '/sites/' . $site->title . '/drushrc.php';
      if (file_exists($drushrc)) {
        global $options;
        $options['db_name'] = NULL;
        $options['db_passwd'] = NULL;
        require $drushrc;
        if (empty($site->db_name) && !empty($options['db_name'])) {
          $site->db_name = $options['db_name'];
        }
        if (empty($site->db_passwd) && !empty($options['db_passwd'])) {
          $site->db_passwd = $options['db_passwd'];
        }
        node_save($site);
      }
    }
  }
}

/**
 * Allow the profile column to be NULL (makes more sense than 0)
 */
function hosting_site_update_7504() {
  db_query('ALTER TABLE hosting_site CHANGE profile profile int(11) DEFAULT NULL');
}

/**
 * Import the Views configuration during D7 to Backdrop upgrade.
 */
function hosting_site_update_1000() {
  config_install_default_config('hosting_site', 'views.view.hosting_site_list');
}

/**
 * Add a layout for platform nodes that shows the list of sites.
 */
function hosting_site_update_1001() {
  if (_hosting_site_layout_add_site_list_block()) {
    return t('Added the "Platform" layout, which lists the sites installed on a platform.');
  }

  return t('Skipped the "Platform" layout: it already exists, or the site list block could not be placed. See the log for details.');
}
